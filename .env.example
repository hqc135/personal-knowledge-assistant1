# ── API Keys（必填） ──────────────────────────────────────
ZHIPUAI_API_KEY=your-zhipuai-key-here
DEEPSEEK_API_KEY=your-deepseek-key-here

# ── Embedding 配置（可选） ────────────────────────────────
# EMBEDDING_MODEL=embedding-3
# EMBEDDING_DIMENSIONS=1024

# ── LLM 配置（可选） ─────────────────────────────────────
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com
# LLM_TEMPERATURE=0.3
# LLM_MAX_TOKENS=1024
# 多轮对话：注入给 LLM 的历史轮数上限（每轮 = 1 user + 1 assistant），设为 0 禁用
# LLM_HISTORY_TURNS=3

# ── Retriever 配置（可选） ────────────────────────────────
# RETRIEVER_TOP_K=5
# RETRIEVER_FINAL_K=3
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# USE_RERANKER=true

# ── 混合检索 配置（可选） ─────────────────────────────────
# USE_HYBRID_SEARCH=true
# RRF_K=60

# ── Intent Router 配置（可选） ───────────────────────────
# USE_INTENT_ROUTER=true
# INTENT_ROUTER_PROTOTYPES_PATH=./intent_prototypes.json
# INTENT_ROUTER_MIN_SCORE=0.45
# INTENT_ROUTER_MIN_MARGIN=0.10
# INTENT_ROUTER_AGG=max
# INTENT_ROUTER_FALLBACK=local
# INTENT_ROUTER_GLOBAL_TOP_K=12
# INTENT_ROUTER_GLOBAL_MAX_SOURCES=3
# INTENT_ROUTER_GLOBAL_MAX_CHARS=4000
# INTENT_ROUTER_GLOBAL_MODE=full
# INTENT_ROUTER_GLOBAL_SUMMARY_MODEL=deepseek-v4-flash
# INTENT_ROUTER_GLOBAL_SUMMARY_MAX_TOKENS=800

# ── Data Pipeline 配置（可选） ────────────────────────────
# CHUNK_SIZE=512
# CHUNK_OVERLAP=64
# CHROMA_DB_PATH=./chroma_db
# COLLECTION_NAME=my_knowledge_base
# NOTES_DIR=./notes

# ── Query Rewriter 配置（可选） ────────────────────────────
# USE_QUERY_REWRITER=true
# QUERY_REWRITER_MODEL=deepseek-v4-flash

# ── Knowledge Graph 配置（可选） ──────────────────────────
# 建议使用非推理模型，避免出现 reasoning_content 有值但 content 为空
# KG_LLM_MODEL=deepseek-chat
# KG_FALLBACK_MODEL=deepseek-chat
# KG_MAX_TRIPLES_PER_CHUNK=8
# KG_ENTITY_VECTOR_TOP_K=5
# KG_ENTITY_VECTOR_MIN_SIM=0.35
# KG_MAX_HOPS=2
# KG_MAX_SUBGRAPH_TRIPLES=30

# ── Parent-Child Hierarchical RAG 配置（可选） ────────────
# 启用后，索引和检索使用两层分块：child (小块) 精准检索 → parent (大块) 喂给 LLM
# USE_PARENT_CHILD=false
# PARENT_COLLECTION_NAME=my_knowledge_base_parents
# PARENT_CHUNK_MAX_SIZE=2500
# PARENT_CHUNK_MIN_SIZE=500
# CHILD_CHUNK_MAX_SIZE=400
# CHILD_CHUNK_MIN_SIZE=80
# PARENT_CHILD_MAX_PARENTS=5

# ── 可观测性 配置（可选） ─────────────────────────────────
# METRICS_MAX_HISTORY=200
