# ── API Keys（必填） ──────────────────────────────────────
ZHIPUAI_API_KEY=your-zhipuai-key-here
DEEPSEEK_API_KEY=your-deepseek-key-here

# ── Embedding 配置（可选） ────────────────────────────────
# EMBEDDING_MODEL=embedding-3
# EMBEDDING_DIMENSIONS=1024

# ── LLM 配置（可选） ─────────────────────────────────────
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com
# LLM_TEMPERATURE=0.3
# LLM_MAX_TOKENS=1024

# ── Retriever 配置（可选） ────────────────────────────────
# RETRIEVER_TOP_K=5
# RETRIEVER_FINAL_K=3
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# USE_RERANKER=true

# ── 混合检索 配置（可选） ─────────────────────────────────
# USE_HYBRID_SEARCH=true
# RRF_K=60

# ── Data Pipeline 配置（可选） ────────────────────────────
# CHUNK_SIZE=512
# CHUNK_OVERLAP=64
# CHROMA_DB_PATH=./chroma_db
# COLLECTION_NAME=my_knowledge_base
# NOTES_DIR=./notes

# ── Knowledge Graph 配置（可选） ──────────────────────────
# 建议使用非推理模型，避免出现 reasoning_content 有值但 content 为空
# KG_LLM_MODEL=deepseek-chat
# KG_FALLBACK_MODEL=deepseek-chat
# KG_MAX_TRIPLES_PER_CHUNK=8

# ── 可观测性 配置（可选） ─────────────────────────────────
# METRICS_MAX_HISTORY=200
